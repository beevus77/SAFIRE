#include "Utilities/FairDivide.hpp"

namespace sfqmc
{
namespace afqmc
{

template<bool MP, class devPsiT>
WalkerSet& StochasticWfn<MP, devPsiT>::inner_wset()
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<bool MP, class devPsiT>
WalkerSet const& StochasticWfn<MP, devPsiT>::inner_wset() const
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<bool MP, class devPsiT>
void StochasticWfn<MP, devPsiT>::initialize_inner_walkers(ptree const& walker_pt,
                                                           boost::multi::array<ComplexType, 3> const& initial_guess,
                                                           int NAEB)
{
  if (inner_ensemble_.initialized)
    APP_ABORT("Error in StochasticWfn::initialize_inner_walkers: inner walkers already initialized.");
  inner_ensemble_.wset =
      std::make_unique<WalkerSet>(TG_, walker_pt, static_cast<AFQMCInfo&>(*this), &inner_ensemble_.rng);
  if (inner_stack_->nomsd().getWalkerType() == COLLINEAR)
    inner_ensemble_.wset->resize(inner_nwalkers_, initial_guess[0],
                                 initial_guess[1](initial_guess.extension(1), {0, NAEB}));
  else
    inner_ensemble_.wset->resize(inner_nwalkers_, initial_guess[0], initial_guess[0]);
  // Phase 3b: keep the anchor |phi_T> so maybe_advance_inner_ensemble() can reset the inner walkers to
  // it before resampling each outer step. WalkerSet::resize only initializes NEW walkers, so it cannot
  // be reused to reset; we re-assign each walker's Slater matrix from this copy instead.
  inner_anchor_ = initial_guess;
  inner_ensemble_.initialized = true;
}

template<bool MP, class devPsiT>
Propagator& StochasticWfn<MP, devPsiT>::inner_propagator()
{
  if (not inner_stack_->has_propagator())
    APP_ABORT("Error in StochasticWfn::inner_propagator: inner propagator not built.");
  return inner_stack_->propagator();
}

template<bool MP, class devPsiT>
Propagator const& StochasticWfn<MP, devPsiT>::inner_propagator() const
{
  if (not inner_stack_->has_propagator())
    APP_ABORT("Error in StochasticWfn::inner_propagator: inner propagator not built.");
  return inner_stack_->propagator();
}

/*
 * Phase 3b: resample the inner (stochastic-trial) ensemble. When the per-outer-step latch is armed
 * (begin_inner_step() was called by the outer propagator) and inner_nsteps_ > 0, reset every inner
 * walker's Slater matrix to the anchor |phi_T> and apply inner_nsteps_ free-projection B_T steps with
 * fresh Gaussian fields, producing a new walker-independent single-step ensemble
 *   {psi_p = B_T(Y^[p]) |phi_T>}   (one Slater determinant per sampled field path; arXiv:2505.18519 Eq. 21).
 * The latch makes this run exactly once per outer step regardless of which reduction is called first.
 *
 * Reset-then-resample (not a continuous free walk): the single-step trial is B_T applied to the
 * ANCHOR with freshly sampled fields, so each outer step starts from |phi_T> again. At inner_nsteps_
 * == 0 this is a no-op and the ensemble stays the static anchor (Phase 1c-3a). The inner-walker
 * WEIGHT/OVLP/PHASE are not consumed by the reductions (which weight by the cross-overlap phase S_p,
 * not the inner-walker weight), so only the Slater matrices need resetting; the inner propagator runs
 * in free-projection mode (forced in buildStochasticInnerStack), so no bias/constraint is applied.
 */
template<bool MP, class devPsiT>
void StochasticWfn<MP, devPsiT>::maybe_advance_inner_ensemble()
{
  if (inner_nsteps_ <= 0)
  {
    inner_step_pending_ = false;
    return;
  }
  if (not inner_step_pending_)
    return;
  inner_step_pending_ = false;

  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::maybe_advance_inner_ensemble: inner walkers not initialized.");
  if (not inner_stack_->has_propagator())
    APP_ABORT("Error in StochasticWfn::maybe_advance_inner_ensemble: inner propagator not built.");

  WalkerSet& inner     = *inner_ensemble_.wset;
  const bool collinear = (inner_stack_->nomsd().getWalkerType() == COLLINEAR);

  // Reset each inner walker's Slater matrix to the anchor. Mirror WalkerSet::resize: only the local-TG
  // root writes the shared walker buffer, with a barrier so the propagator sees a consistent ensemble.
  if (TG_.TG_local().root())
  {
    for (int ip = 0; ip < inner.size(); ++ip)
    {
      *inner[ip].SlaterMatrix(Alpha) = inner_anchor_[0];
      if (collinear)
      {
        int naeb = (*inner[ip].SlaterMatrix(Beta)).size(1);
        *inner[ip].SlaterMatrix(Beta) = inner_anchor_[1](inner_anchor_.extension(1), {0, naeb});
      }
    }
  }
  TG_.TG_local().barrier();

  // Apply inner_nsteps_ free-projection B_T steps (Eshift = 0: it only rescales the inner-walker
  // WEIGHT in free_projection_walker_update, which the reductions never read). dt from inner_timestep_.
  RealType eshift(0);
  RealType dt(inner_timestep_);
  inner_propagator().Propagate(inner_nsteps_, inner, eshift, dt, 1);
  TG_.TG_local().barrier();
}

/*
 * Stochastic trial overlap (Phase 2, static-ensemble limit). For each outer walker phi_w
 * we reduce the inner ensemble {psi_p} (p = 0..P-1) into an effective overlap
 *   Ov[w] = (1/P) sum_p <psi_p | phi_w>,
 * the inner_nsteps = 0 specialization of Eq. 24 of arXiv:2505.18519 (B_T = 1, so the phase
 * factor S(Y) and importance reweighting of Eq. 25-26 are degenerate and reduce to a plain
 * average; those arrive with the inner-propagation leapfrog in Phase 3). Each <psi_p|phi_w>
 * is a single-determinant overlap between the inner-walker and outer-walker Slater matrices,
 * evaluated with herm = false (so SlaterDetOperations forms det(psi_p^dagger phi_w)) and with
 * the same LogOverlapFactor as NOMSD::Overlap, so the single-determinant delegate limit
 * (inner ensemble == trial determinant) reproduces the NOMSD overlap exactly.
 */
template<bool MP, class devPsiT>
template<class WlkSet, class TVec>
void StochasticWfn<MP, devPsiT>::Overlap(const WlkSet& wset, TVec&& Ov)
{
  using std::fill_n;
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::Overlap: inner walkers not initialized "
              "(call maybe_initialize_stochastic_inner_walkers first).");
  // Phase 3b: resample the dynamic inner ensemble once per outer step (no-op at inner_nsteps_ == 0).
  maybe_advance_inner_ensemble();
  // Overlap stays the ABSOLUTE reduction Ov[w] = (1/P) sum_p <psi_p|phi_w> (Eq. 24's normalization).
  // The S_p phase weight (Eq. 26) enters only the ratio estimators (Energy/MixedDM, where the per-walker
  // normalization N(phi) cancels); dropping the magnitude here would break Overlap == NOMSD at the
  // delegate limit, and the exact N(phi) cancellation is the Phase 3c leapfrog.
  WalkerSet& inner = *inner_ensemble_.wset;
  const int nw     = wset.size();
  const int P      = inner.size();
  RUNTIME_CHECK(Ov.size() >= nw, "");
  RUNTIME_CHECK(P >= 1, "");
  const double LogOverlapFactor = wset.getLogOverlapFactor();
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  auto& SDetOp          = *nomsd_.getSlaterDetOperations();

  fill_n(Ov.origin(), nw, ComplexType(0));

  // Distribute the nw*P (outer walker, inner walker) pairs across the local task group;
  // task tk = iw * P + ip.
  int tk0, tkN;
  std::tie(tk0, tkN) = FairDivideBoundary(TG_.getLocalTGRank(), nw * P, TG_.getNCoresPerTG());

  for (int tk = tk0; tk < tkN; ++tk)
  {
    const int iw = tk / P;
    const int ip = tk % P;
    if (wt != COLLINEAR)
    {
      ComplexType ov = SDetOp.Overlap(*inner[ip].SlaterMatrix(Alpha), *wset[iw].SlaterMatrix(Alpha),
                                      LogOverlapFactor, false);
      Ov[iw] += inv_P * ov * ((wt == CLOSED) ? ov : ComplexType(1.0, 0.0));
    }
    else
    {
      ComplexType ov = SDetOp.Overlap(*inner[ip].SlaterMatrix(Alpha), *wset[iw].SlaterMatrix(Alpha),
                                      LogOverlapFactor, false);
      ov *= SDetOp.Overlap(*inner[ip].SlaterMatrix(Beta), *wset[iw].SlaterMatrix(Beta),
                           LogOverlapFactor, false);
      Ov[iw] += inv_P * ov;
    }
  }

  if (TG_.TG_local().size() > 1)
    TG_.TG_local().all_reduce_in_place_n(raw_pointer_cast(Ov.origin()), nw, std::plus<>());
}

template<bool MP, class devPsiT>
template<class WlkSet>
void StochasticWfn<MP, devPsiT>::Overlap(WlkSet& wset)
{
  int nw = wset.size();
  StaticVector ovlp(iextensions<1u>{nw}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  Overlap(wset, ovlp);
  TG_.TG_local().barrier();
  if (TG_.getLocalTGRank() == 0)
    wset.setProperty(OVLP, ovlp);
  TG_.TG_local().barrier();
}

/*
 * Stochastic trial local energy (Phase 2b / Phase 3b). For each outer walker phi_w we reduce the
 * inner ensemble {psi_p} (p = 0..P-1) into an effective local energy and overlap (Eq. 27 of
 * arXiv:2505.18519):
 *   E[w]  = sum_p S_p[w] E_{p,w} / sum_p S_p[w],   E_{p,w} = <psi_p|H|phi_w>/<psi_p|phi_w>,
 *   Ov[w] = (1/P) sum_p <psi_p|phi_w>,             S_p[w]  = <psi_p|phi_w>/|<psi_p|phi_w>| (Eq. 26).
 * The per-inner-walker cross-DM loop, the S_p phase weight, the denominator D[w] = sum_p S_p[w], and
 * the absolute overlap Ov are all handled by the shared helper reduce_inner_cross_dm; here we only
 * supply the energy numerator via the accumulate callback. At inner_nsteps_ == 0 every psi_p equals
 * the anchor so the S_p are degenerate and E/Ov collapse to the Phase 3a values (and to NOMSD at the
 * single-determinant delegate limit); the difference from the old (1/P)<psi_p|phi_w> weighting is
 * summation-order only at the static limit.
 *
 * Hamiltonian sourcing (dual-Hamiltonian architecture; see StochasticDevelopment.md): H is the *True*
 * Hamiltonian (outer delegate nomsd_), not inner_nomsd() (which becomes the Variational Ham). The
 * cross DM is Hamiltonian-independent (computed on nomsd_'s SDetOp), but the energy contraction is.
 *
 * Half-rotation (Phase 3b): once inner walkers leave the anchor (inner_nsteps_ > 0) the nd = 0
 * half-rotated integrals no longer match the cross-DM basis, so we form the FULL (NMO x NMO) cross G
 * (compact = false) and contract it with the un-rotated full Cholesky via energy_from_fullG. At
 * inner_nsteps_ == 0 we keep the proven compact nd = 0 path (energy_from_G), so the static delegate
 * limit is byte-for-byte the Phase 2b code (up to the S_p vs 1/P summation noted above).
 */
template<bool MP, class devPsiT>
template<class WlkSet, class Mat, class TVec>
void StochasticWfn<MP, devPsiT>::Energy(const WlkSet& wset, Mat&& E, TVec&& Ov)
{
  using std::fill_n;
  RUNTIME_CHECK(E.dimensionality == 2, "");
  RUNTIME_CHECK(Ov.dimensionality == 1, "");
  RUNTIME_CHECK(E.size(0) == wset.size(), "");
  RUNTIME_CHECK(E.size(1) == 3, "");
  RUNTIME_CHECK(E.stride(0) == E.size(1), ""); // contiguous: fill_n / all_reduce span 3*nwalk
  RUNTIME_CHECK(Ov.size(0) == wset.size(), "");

  NOMSD<MP, devPsiT>& ref = nomsd_;
  const int nwalk       = wset.size();
  const ComplexType zero(0.0);
  const bool full       = (inner_nsteps_ > 0);  // dynamic ensemble -> un-rotated full-G energy
  const bool compact    = not full;             // static (Phase 3a): compact nd = 0 half-rotation
  // Full-G energy (energy_from_fullG / full_g::energy_closed) expects G as [nwalk][NMO*NMO], so request
  // the transposed layout uniformly when dynamic (DensityMatrix is Hamiltonian-independent, so it can
  // produce either layout regardless of the HamOp's transposed_G_for_E()). Static keeps the compact
  // nd = 0 layout the HamOp's energy() expects.
  const bool transposed = full ? true : ref.transposed_G_for_E();
  const int Gsize       = ref.dm_size(full);    // full size when dynamic, compact when static
  const bool root       = TG_.TG_local().root();

  // E[w][k] accumulates the partial (per-core) numerator sum_p S_p[w] E_{p,w}[k]; the helper fills the
  // denominator D[w] = sum_p S_p[w] and the absolute overlap Ov[w]. eloc2 is per-ip scratch.
  StaticMatrix eloc2({nwalk, 3}, zero, buffer_manager.get_generator().template get_allocator<ComplexType>());
  StaticVector D(iextensions<1u>{nwalk}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  fill_n(E.origin(), 3 * nwalk, zero);

  reduce_inner_cross_dm(wset, compact, transposed, Gsize, D, Ov,
    [&](auto& Gp, auto& /*ov_*/, auto& Sp, int /*ip*/, int /*r0*/, int /*rN*/) {
      // E_{p,w}[k] = (E1, EXX, EJ) of the cross mixed DM, scored against the True Ham. addH1 only on
      // root so the all_reduce below does not multiply E0/one-body by the core count.
      if (full)
        ref.energy_from_fullG(eloc2, Gp, root);
      else
        ref.energy_from_G(eloc2, Gp, /*nd=*/0, root);
      // E[w][k] += S_p[w] * E_{p,w}[k]
      ma::elementwise(ma::TOp_MUL, 0, ComplexType(1.0), Sp, eloc2);
      ma::add(ComplexType(1.0), eloc2, ComplexType(1.0), E, E);
    });

  // E holds partial (per-core) numerators; reduce, then divide by the phase-weight denominator D.
  if (TG_.TG_local().size() > 1)
    TG_.TG_local().all_reduce_in_place_n(raw_pointer_cast(E.origin()), 3 * nwalk, std::plus<>());
  ma::elementwise(ma::TOp_DIV, 0, D, E);
  TG_.TG_local().barrier();
}

template<bool MP, class devPsiT>
template<class WlkSet>
void StochasticWfn<MP, devPsiT>::Energy(WlkSet& wset)
{
  int nw = wset.size();
  StaticVector ovlp(iextensions<1u>{nw}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  StaticMatrix eloc({nw, 3}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  Energy(wset, eloc, ovlp);
  TG_.TG_local().barrier();
  if (TG_.getLocalTGRank() == 0)
  {
    wset.setProperty(OVLP, ovlp);
    wset.setProperty(E1_, eloc(eloc.extension(), 0));
    wset.setProperty(EXX_, eloc(eloc.extension(), 1));
    wset.setProperty(EJ_, eloc(eloc.extension(), 2));
  }
  TG_.TG_local().barrier();
}

/*
 * Phase 3b shared reduction. Both Energy (2b) and MixedDensityMatrix_for_vbias (3a) reduce the inner
 * ensemble {psi_p} into a per-outer-walker phase-weighted average (Eq. 27 of arXiv:2505.18519): the
 * per-inner-walker cross-DM loop, the cross overlap ov_ = <psi_p|phi_w>, the phase weight
 * S_p[w] = ov_[w]/|ov_[w]| (Eq. 26), the denominator D[w] = sum_p S_p[w], and the absolute overlap
 * Ov[w] = (1/P) sum_p ov_[w] (Eq. 24's normalization) are identical between them; only the numerator
 * differs. This helper owns all of the shared machinery and calls back accumulate(Gp, ov_, S_p, ip,
 * r0, rN) so each estimator folds the cross mixed DM Gp into its own S_p-weighted numerator. (r0, rN)
 * is this core's band of the Gsize dimension (the MixedDM numerator is banded; the Energy numerator
 * uses the full G and ignores the band). It also drives the dynamic ensemble: maybe_advance_inner_-
 * ensemble() resamples {psi_p} once per outer step before the loop.
 *
 * The cross DM and ov_ run on the OUTER delegate nomsd_ (the True Hamiltonian SDetOp); herm = false
 * because the inner-walker Slater matrix is [NMO, NEL]. D, Ov, and S_p are computed from the shared,
 * complete ov_, so they are complete on every core (no all-reduce). The S_p loop is a host loop (CPU
 * path; GPU re-vectorization of the phase weight is a deferred follow-up).
 */
template<bool MP, class devPsiT>
template<class WlkSet, class TVecD, class TVecOv, class Accumulate>
void StochasticWfn<MP, devPsiT>::reduce_inner_cross_dm(const WlkSet& wset,
                                                       bool compact,
                                                       bool transposed,
                                                       int Gsize,
                                                       TVecD&& D,
                                                       TVecOv&& Ov,
                                                       Accumulate&& accumulate)
{
  using std::fill_n;
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::reduce_inner_cross_dm: inner walkers not initialized "
              "(call maybe_initialize_stochastic_inner_walkers first).");
  // Distributed Cholesky (NGroupsPerTG > 1) is deferred (as in Phase 2b/3a): a single energy/vbias
  // contraction sees only one group's Cholesky vectors. NOMSD handles this with a ring reduction.
  if (TG_.getNGroupsPerTG() > 1)
    APP_ABORT("Error in StochasticWfn::reduce_inner_cross_dm: distributed (NGroupsPerTG > 1) stochastic "
              "reduction not yet supported (shared-only; see StochasticDevelopment.md).");

  // Phase 3b: resample the dynamic inner ensemble once per outer step (no-op at inner_nsteps_ == 0).
  maybe_advance_inner_ensemble();

  WalkerSet& inner        = *inner_ensemble_.wset;
  NOMSD<MP, devPsiT>& ref = nomsd_;
  const int nwalk         = wset.size();
  const int P             = inner.size();
  RUNTIME_CHECK(P >= 1, "");
  const bool collinear = (ref.getWalkerType() == COLLINEAR);
  const ComplexType zero(0.0);
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);

  int nr = Gsize, nc = nwalk;
  if (transposed)
    std::swap(nr, nc);

  // Shared cross mixed DM Gp with its per-walker overlap ov_ packed contiguously (mirrors
  // NOMSD::Energy_shared). Gp/ov_ must be shared: DensityMatrix fills them collectively (round-robin
  // over walkers across the local TG).
  StaticSHMVector shmbuff(iextensions<1u>{(Gsize + 1) * nwalk}, zero,
                          shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
  CMatrix_ref Gp(make_device_ptr(shmbuff.origin()), {nr, nc});
  CVector_ref ov_(Gp.origin() + Gp.num_elements(), iextensions<1u>{nwalk});
  // Per-pair phase weight S_p[w] (Eq. 26); per-core local but complete on every core.
  StaticVector Sp(iextensions<1u>{nwalk}, buffer_manager.get_generator().template get_allocator<ComplexType>());

  fill_n(D.origin(), nwalk, zero);
  fill_n(Ov.origin(), nwalk, zero);

  // Band of the Gsize dimension owned by this core (for the callback's banded numerator writes), as in
  // NOMSD::MixedDensityMatrix_shared -- each band written by one core, no mutex, no double counting.
  int r0, rN;
  std::tie(r0, rN) = FairDivideBoundary(TG_.getLocalTGRank(), Gsize, TG_.getNCoresPerTG());

  for (int ip = 0; ip < P; ++ip)
  {
    auto smA = inner[ip].SlaterMatrix(Alpha);
    auto smB = (collinear ? inner[ip].SlaterMatrix(Beta) : inner[ip].SlaterMatrix(Alpha));
    // Gp = <psi_p|c^dag c|phi_w>/<psi_p|phi_w> (normalized), ov_ = <psi_p|phi_w> (full overlap; squared
    // for CLOSED, alpha*beta for COLLINEAR). Fills the whole shared Gp/ov_.
    ref.DensityMatrix(wset, *smA, *smB, Gp, ov_, /*herm=*/false, compact, transposed);
    // S_p[w] = ov_[w]/|ov_[w]| (Eq. 26); D[w] += S_p[w]; Ov[w] += (1/P) ov_[w] (absolute, Eq. 24). The
    // shared ov_ is complete on every core, so D/Ov/S_p are complete on every core (no all-reduce).
    // S_p is a unit phase for ANY nonzero overlap; only an exactly-orthogonal pair (|ov_| == 0,
    // measure-zero) contributes nothing. NOTE: the ratio estimators divide by D[w] = sum_p S_p[w]; a
    // near-zero D (random phases failing to add up) is the inherent high-variance pathology of the
    // walker-INDEPENDENT Phase 3b ensemble -- the Phase 3c importance sampling (conditioning {psi_p} on
    // phi_w) is what makes D well-behaved. Same family as NOMSD dividing by the trial overlap.
    for (int w = 0; w < nwalk; ++w)
    {
      ComplexType o = ov_[w];
      double mag    = std::abs(o);
      ComplexType s = (mag > 0.0) ? (o / ComplexType(mag, 0.0)) : zero;
      Sp[w]         = s;
      D[w]          = D[w] + s;
      Ov[w]         = Ov[w] + inv_P * o;
    }
    // Fold G_{p,w} into the caller's S_p-weighted numerator.
    accumulate(Gp, ov_, Sp, ip, r0, rN);
    // All cores finish reading/modifying the shared Gp before the next DensityMatrix overwrites it.
    TG_.TG_local().barrier();
  }
}

/*
 * Stochastic mixed density matrix for the force bias (Phase 3a / Phase 3b). For each outer walker
 * phi_w we reduce the inner ensemble {psi_p} into the effective mixed DM the force bias contracts
 * against (estimator 3 / Eq. 27 of arXiv:2505.18519):
 *   G[w] = sum_p S_p[w] G_{p,w} / sum_p S_p[w],   G_{p,w} = <psi_p|c^dag c|phi_w>/<psi_p|phi_w>.
 * The per-inner-walker cross-DM loop, S_p phase weights (Eq. 26), and denominator D[w] = sum_p S_p[w]
 * are handled by reduce_inner_cross_dm; here we supply the S_p-weighted numerator via the callback and
 * normalize. The contraction x_gamma[w] = L_gamma . G[w] (estimator 4) runs through StochasticWfn::vbias.
 * At inner_nsteps_ == 0 the S_p degenerate and G collapses to the Phase 3a value (NOMSD at the
 * single-determinant delegate limit).
 *
 * Layout / half-rotation: at inner_nsteps_ == 0 the OUTER nomsd_ compact/half-rotated vbias layout
 * (the cross DM's nd = 0 basis matches the anchor). Once inner walkers leave the anchor
 * (inner_nsteps_ > 0) that half-rotation is invalid, so we produce the FULL un-rotated layout
 * [NMO*NMO][nwalk] (compact = false, transposed = false) that vbias_fullG contracts with the full
 * Cholesky -- matching the size_of_G_for_vbias()/transposed_G_for_vbias() overrides the propagator
 * uses to size this G. The cross DM itself is Hamiltonian-independent and runs on the True-Ham nomsd_.
 *
 * The S_p-weighted numerator accumulates in a full-precision shared scratch (Gnum) and is cast once
 * into the caller's (possibly single-precision) vbias G via copy_n_cast, so the reduction never mixes
 * precisions in ma::add / ma::elementwise; this mirrors the propagator's own SP handling.
 */
template<bool MP, class devPsiT>
template<class WlkSet, class MatG>
void StochasticWfn<MP, devPsiT>::MixedDensityMatrix_for_vbias(const WlkSet& wset, MatG&& G)
{
  using std::fill_n;
  NOMSD<MP, devPsiT>& ref = nomsd_;
  const int nwalk       = wset.size();
  const ComplexType zero(0.0);
  const bool full       = (inner_nsteps_ > 0);
  const bool compact    = full ? false : ref.compact_G_for_vbias;
  const bool transposed = full ? false : ref.transposed_G_for_vbias_;
  const int Gsize       = full ? ref.dm_size(true) : ref.dm_size(not ref.compact_G_for_vbias);

  // Output G must be in the advertised vbias layout (same checks as DensityMatrix_shared / vbias).
  RUNTIME_CHECK(G.stride(1) == 1, "");
  if (transposed)
    RUNTIME_CHECK(G.size(0) == nwalk && G.size(1) == Gsize, "");
  else
    RUNTIME_CHECK(G.size(1) == nwalk && G.size(0) == Gsize, "");
  RUNTIME_CHECK(G.stride(0) == G.size(1), ""); // contiguous: cast-copy spans Gsize*nwalk linearly

  int nr = Gsize, nc = nwalk;
  if (transposed)
    std::swap(nr, nc);

  // Full-precision numerator Gnum[w] = sum_p S_p[w] G_{p,w} (same layout as G). The helper fills the
  // denominator D[w] = sum_p S_p[w]; Ov is filled but unused here (vbias normalizes by D, not Ov).
  StaticSHMVector gnumbuff(iextensions<1u>{Gsize * nwalk}, zero,
                           shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
  CMatrix_ref Gnum(make_device_ptr(gnumbuff.origin()), {nr, nc});
  StaticVector D(iextensions<1u>{nwalk}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  StaticVector Ov(iextensions<1u>{nwalk}, buffer_manager.get_generator().template get_allocator<ComplexType>());

  fill_n(Gnum.origin(), Gnum.num_elements(), zero);
  TG_.TG_local().barrier();

  reduce_inner_cross_dm(wset, compact, transposed, Gsize, D, Ov,
    [&](auto& Gp, auto& /*ov_*/, auto& Sp, int /*ip*/, int r0, int rN) {
      // Gnum[band][w] += S_p[w] * G_{p,w}[band][w] (this core's Gsize-band only). Weight Gp in place by
      // S_p along the walker axis, then add into Gnum (both full precision: no mixed add).
      if (rN > r0)
      {
        if (transposed)
        {
          auto Gpband   = Gp(Gp.extension(0), {r0, rN});
          auto Gnumband = Gnum(Gnum.extension(0), {r0, rN});
          ma::elementwise(ma::TOp_MUL, 0, ComplexType(1.0), Sp, Gpband);
          ma::add(ComplexType(1.0), Gpband, ComplexType(1.0), Gnumband, Gnumband);
        }
        else
        {
          auto Gpband   = Gp.sliced(r0, rN);
          auto Gnumband = Gnum.sliced(r0, rN);
          ma::elementwise(ma::TOp_MUL, 1, ComplexType(1.0), Sp, Gpband);
          ma::add(ComplexType(1.0), Gpband, ComplexType(1.0), Gnumband, Gnumband);
        }
      }
    });

  // Normalize the numerator by the phase-weight denominator: G[w] = Gnum[w] / D[w] (this core's band).
  int r0, rN;
  std::tie(r0, rN) = FairDivideBoundary(TG_.getLocalTGRank(), Gsize, TG_.getNCoresPerTG());
  if (rN > r0)
  {
    if (transposed)
    {
      auto Gnumband = Gnum(Gnum.extension(0), {r0, rN});
      ma::elementwise(ma::TOp_DIV, 0, D, Gnumband);
    }
    else
    {
      auto Gnumband = Gnum.sliced(r0, rN);
      ma::elementwise(ma::TOp_DIV, 1, D, Gnumband);
    }
  }
  TG_.TG_local().barrier();

  // Cast the full-precision numerator into the caller's (possibly single-precision) vbias G. Partition
  // the linear copy across the local TG; Gnum and G share an identical contiguous layout.
  int e0, eN;
  std::tie(e0, eN) = FairDivideBoundary(TG_.getLocalTGRank(), int(Gnum.num_elements()), TG_.getNCoresPerTG());
  if (eN > e0)
    copy_n_cast(make_device_ptr(Gnum.origin()) + e0, eN - e0, make_device_ptr(G.origin()) + e0);
  TG_.TG_local().barrier();
}

template<bool MP, class devPsiT>
template<class Mat>
void StochasticWfn<MP, devPsiT>::G_MF(Mat&& G)
{
  nomsd_.G_MF(std::forward<Mat>(G));
}

template<bool MP, class devPsiT>
template<class Vec>
void StochasticWfn<MP, devPsiT>::vMF(Vec&& v, double dt)
{
  nomsd_.vMF(std::forward<Vec>(v), dt);
}

} // namespace afqmc

} // namespace sfqmc
