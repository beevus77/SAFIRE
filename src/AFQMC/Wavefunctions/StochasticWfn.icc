#include "Utilities/FairDivide.hpp"

namespace sfqmc
{
namespace afqmc
{

template<bool MP, class devPsiT>
WalkerSet& StochasticWfn<MP, devPsiT>::inner_wset()
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<bool MP, class devPsiT>
WalkerSet const& StochasticWfn<MP, devPsiT>::inner_wset() const
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<bool MP, class devPsiT>
void StochasticWfn<MP, devPsiT>::initialize_inner_walkers(ptree const& walker_pt,
                                                           boost::multi::array<ComplexType, 3> const& initial_guess,
                                                           int NAEB)
{
  if (inner_ensemble_.initialized)
    APP_ABORT("Error in StochasticWfn::initialize_inner_walkers: inner walkers already initialized.");
  inner_ensemble_.wset =
      std::make_unique<WalkerSet>(TG_, walker_pt, static_cast<AFQMCInfo&>(*this), &inner_ensemble_.rng);
  if (inner_stack_->nomsd().getWalkerType() == COLLINEAR)
    inner_ensemble_.wset->resize(inner_nwalkers_, initial_guess[0],
                                 initial_guess[1](initial_guess.extension(1), {0, NAEB}));
  else
    inner_ensemble_.wset->resize(inner_nwalkers_, initial_guess[0], initial_guess[0]);
  inner_ensemble_.initialized = true;
}

template<bool MP, class devPsiT>
Propagator& StochasticWfn<MP, devPsiT>::inner_propagator()
{
  if (not inner_stack_->has_propagator())
    APP_ABORT("Error in StochasticWfn::inner_propagator: inner propagator not built.");
  return inner_stack_->propagator();
}

template<bool MP, class devPsiT>
Propagator const& StochasticWfn<MP, devPsiT>::inner_propagator() const
{
  if (not inner_stack_->has_propagator())
    APP_ABORT("Error in StochasticWfn::inner_propagator: inner propagator not built.");
  return inner_stack_->propagator();
}

/*
 * Stochastic trial overlap (Phase 2, static-ensemble limit). For each outer walker phi_w
 * we reduce the inner ensemble {psi_p} (p = 0..P-1) into an effective overlap
 *   Ov[w] = (1/P) sum_p <psi_p | phi_w>,
 * the inner_nsteps = 0 specialization of Eq. 24 of arXiv:2505.18519 (B_T = 1, so the phase
 * factor S(Y) and importance reweighting of Eq. 25-26 are degenerate and reduce to a plain
 * average; those arrive with the inner-propagation leapfrog in Phase 3). Each <psi_p|phi_w>
 * is a single-determinant overlap between the inner-walker and outer-walker Slater matrices,
 * evaluated with herm = false (so SlaterDetOperations forms det(psi_p^dagger phi_w)) and with
 * the same LogOverlapFactor as NOMSD::Overlap, so the single-determinant delegate limit
 * (inner ensemble == trial determinant) reproduces the NOMSD overlap exactly.
 */
template<bool MP, class devPsiT>
template<class WlkSet, class TVec>
void StochasticWfn<MP, devPsiT>::Overlap(const WlkSet& wset, TVec&& Ov)
{
  using std::fill_n;
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::Overlap: inner walkers not initialized "
              "(call maybe_initialize_stochastic_inner_walkers first).");
  WalkerSet& inner = *inner_ensemble_.wset;
  const int nw     = wset.size();
  const int P      = inner.size();
  RUNTIME_CHECK(Ov.size() >= nw, "");
  RUNTIME_CHECK(P >= 1, "");
  const double LogOverlapFactor = wset.getLogOverlapFactor();
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  auto& SDetOp          = *nomsd_.getSlaterDetOperations();

  fill_n(Ov.origin(), nw, ComplexType(0));

  // Distribute the nw*P (outer walker, inner walker) pairs across the local task group;
  // task tk = iw * P + ip.
  int tk0, tkN;
  std::tie(tk0, tkN) = FairDivideBoundary(TG_.getLocalTGRank(), nw * P, TG_.getNCoresPerTG());

  for (int tk = tk0; tk < tkN; ++tk)
  {
    const int iw = tk / P;
    const int ip = tk % P;
    if (wt != COLLINEAR)
    {
      ComplexType ov = SDetOp.Overlap(*inner[ip].SlaterMatrix(Alpha), *wset[iw].SlaterMatrix(Alpha),
                                      LogOverlapFactor, false);
      Ov[iw] += inv_P * ov * ((wt == CLOSED) ? ov : ComplexType(1.0, 0.0));
    }
    else
    {
      ComplexType ov = SDetOp.Overlap(*inner[ip].SlaterMatrix(Alpha), *wset[iw].SlaterMatrix(Alpha),
                                      LogOverlapFactor, false);
      ov *= SDetOp.Overlap(*inner[ip].SlaterMatrix(Beta), *wset[iw].SlaterMatrix(Beta),
                           LogOverlapFactor, false);
      Ov[iw] += inv_P * ov;
    }
  }

  if (TG_.TG_local().size() > 1)
    TG_.TG_local().all_reduce_in_place_n(raw_pointer_cast(Ov.origin()), nw, std::plus<>());
}

template<bool MP, class devPsiT>
template<class WlkSet>
void StochasticWfn<MP, devPsiT>::Overlap(WlkSet& wset)
{
  int nw = wset.size();
  StaticVector ovlp(iextensions<1u>{nw}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  Overlap(wset, ovlp);
  TG_.TG_local().barrier();
  if (TG_.getLocalTGRank() == 0)
    wset.setProperty(OVLP, ovlp);
  TG_.TG_local().barrier();
}

/*
 * Stochastic trial local energy (Phase 2b, static-ensemble limit). For each outer walker phi_w
 * we reduce the inner ensemble {psi_p} (p = 0..P-1) into an effective local energy and overlap
 *   E[w]  = sum_p <psi_p|H|phi_w> / sum_p <psi_p|phi_w>,
 *   Ov[w] = (1/P) sum_p <psi_p|phi_w>,
 * the inner_nsteps = 0 specialization of Eq. 27 of arXiv:2505.18519 (B_T = 1, so the phase
 * factor S(Y) and importance reweighting of Eq. 25-26 are degenerate and reduce to a plain
 * average; those arrive with the inner-propagation leapfrog in Phase 3). The reduction mirrors
 * NOMSD::Energy_shared exactly, with the trial-determinant loop replaced by the inner-walker
 * loop and the CI weight conj(ci[nd]) replaced by 1/P: per inner walker we form the cross mixed
 * density matrix against every outer walker, accumulate (1/P)<psi_p|phi_w> into Ov and
 * (1/P)<psi_p|phi_w> E_{p,w} into E, then divide E by Ov to obtain the local energy. The 1/P
 * cancels in E but is kept so Ov[w] is the same reduction as Phase 2a Overlap -- the same
 * per-pair terms (1/P)<psi_p|phi_w>, hence equal up to floating-point summation order (Phase 2a
 * sums nw*P pairs via FairDivide + all_reduce; here we sum per inner walker). The
 * stochastic_energy_matches_nomsd test asserts this Overlap/Energy agreement within Approx.
 *
 * The cross mixed DM uses herm = false (the inner walker Slater matrix is [NMO, NEL], as in
 * Phase 2a Overlap, rather than the pre-transposed trial NOMSD passes with herm = true).
 *
 * Hamiltonian sourcing (dual-Hamiltonian architecture; see StochasticDevelopment.md): H is the
 * *True* Hamiltonian, which lives in the OUTER delegate nomsd_ -- so the cross DM and energy_from_G
 * run on nomsd_, NOT inner_nomsd(). The inner stack's HamOps becomes the *Variational* Hamiltonian
 * once Phase 3b drives B_T, at which point inner_nomsd().energy_from_G would return the wrong
 * operator. (The bras psi_p are still the inner WALKERS from inner_ensemble_.wset; only the
 * Ham-dependent contraction is scored on nomsd_. The cross DM itself is Hamiltonian-independent.)
 * energy_from_G is called with nd = 0 because in the static-ensemble limit every inner walker
 * equals the trial's anchor determinant (getInitialGuess == OrbMats[0]), whose half-rotated
 * integrals back the nd = 0 energy; Phase 3b must revisit this (per-walker nd) once inner walkers
 * are propagated away from the anchor. At the single-determinant delegate limit both E and Ov
 * reproduce NOMSD exactly.
 */
template<bool MP, class devPsiT>
template<class WlkSet, class Mat, class TVec>
void StochasticWfn<MP, devPsiT>::Energy(const WlkSet& wset, Mat&& E, TVec&& Ov)
{
  using std::fill_n;
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::Energy: inner walkers not initialized "
              "(call maybe_initialize_stochastic_inner_walkers first).");
  // Cholesky-distributed reduction (NGroupsPerTG > 1) is deferred: a single energy_from_G call
  // sees only this group's Cholesky vectors, so it would return a partial energy. NOMSD handles
  // this with a ring reduction (Energy_distributed); Phase 2b targets the shared limit.
  if (TG_.getNGroupsPerTG() > 1)
    APP_ABORT("Error in StochasticWfn::Energy: distributed (NGroupsPerTG > 1) stochastic energy "
              "not yet supported (Phase 2b is shared-only; see StochasticDevelopment.md).");

  RUNTIME_CHECK(E.dimensionality == 2, "");
  RUNTIME_CHECK(Ov.dimensionality == 1, "");
  RUNTIME_CHECK(E.size(0) == wset.size(), "");
  RUNTIME_CHECK(E.size(1) == 3, "");
  RUNTIME_CHECK(E.stride(0) == E.size(1), ""); // contiguous: fill_n / all_reduce span 3*nwalk
  RUNTIME_CHECK(Ov.size(0) == wset.size(), "");

  WalkerSet& inner = *inner_ensemble_.wset;
  const int nwalk  = wset.size();
  const int P      = inner.size();
  RUNTIME_CHECK(P >= 1, "");

  // Score against the True Hamiltonian: use the OUTER delegate nomsd_, not inner_nomsd() (whose
  // HamOps becomes the Variational Ham at Phase 3b). nomsd_ shares TG_ with this reduction, so its
  // DensityMatrix / energy_from_G barriers stay consistent. The bras psi_p are the inner WALKERS
  // (inner_ensemble_.wset, indexed below); only the Ham-dependent contraction lives on nomsd_.
  NOMSD<MP, devPsiT>& ref = nomsd_;
  const ComplexType zero(0.0);
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const bool collinear    = (ref.getWalkerType() == COLLINEAR);
  const bool transposed_E = ref.transposed_G_for_E();
  const int Gsize         = ref.dm_size(false); // compact G size; dm_size is friend-accessible

  // Shared mixed density matrix G with its per-walker overlap ov_ packed contiguously after it
  // (mirrors NOMSD::Energy_shared); per-core energy components eloc2.
  int nr = Gsize, nc = nwalk;
  if (transposed_E)
    std::swap(nr, nc);
  StaticSHMVector shmbuff(iextensions<1u>{(Gsize + 1) * nwalk}, ComplexType(0.0),
                          shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
  CMatrix_ref G(make_device_ptr(shmbuff.origin()), {nr, nc});
  CVector_ref ov_(G.origin() + G.num_elements(), iextensions<1u>{nwalk});
  StaticMatrix eloc2({nwalk, 3}, ComplexType(0.0),
                     buffer_manager.get_generator().template get_allocator<ComplexType>());

  fill_n(Ov.origin(), nwalk, zero);
  fill_n(E.origin(), 3 * nwalk, zero);

  for (int ip = 0; ip < P; ++ip)
  {
    auto smA = inner[ip].SlaterMatrix(Alpha);
    auto smB = (collinear ? inner[ip].SlaterMatrix(Beta) : inner[ip].SlaterMatrix(Alpha));
    // G = <psi_p|c^dag c|phi_w>/<psi_p|phi_w>, ov_ = <psi_p|phi_w> (squared for CLOSED, as in NOMSD).
    ref.DensityMatrix(wset, *smA, *smB, G, ov_, /*herm=*/false, /*compact=*/true, transposed_E);
    // Ov[w] += (1/P) <psi_p|phi_w>   -- the Phase 2a overlap reduction term.
    ma::axpy(inv_P, ov_, Ov);
    // eloc2[w][k] = E_{p,w}[k] = (E1, EXX, EJ) of the cross mixed DM (overwritten each iteration).
    ref.energy_from_G(eloc2, G, /*nd=*/0, TG_.TG_local().root());
    // eloc2[w][k] *= (1/P) <psi_p|phi_w>   -- weight the local energy by its overlap.
    ma::elementwise(ma::TOp_MUL, 0, inv_P, ov_, eloc2);
    // E[w][k] += eloc2[w][k]   -- accumulate the energy numerator.
    ma::add(ComplexType(1.0), eloc2, ComplexType(1.0), E, E);
  }

  // E holds partial (per-core) energy numerators; reduce, then divide by the total overlap Ov.
  if (TG_.TG_local().size() > 1)
    TG_.TG_local().all_reduce_in_place_n(raw_pointer_cast(E.origin()), 3 * nwalk, std::plus<>());
  ma::elementwise(ma::TOp_DIV, 0, Ov, E);
  TG_.TG_local().barrier();
}

template<bool MP, class devPsiT>
template<class WlkSet>
void StochasticWfn<MP, devPsiT>::Energy(WlkSet& wset)
{
  int nw = wset.size();
  StaticVector ovlp(iextensions<1u>{nw}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  StaticMatrix eloc({nw, 3}, buffer_manager.get_generator().template get_allocator<ComplexType>());
  Energy(wset, eloc, ovlp);
  TG_.TG_local().barrier();
  if (TG_.getLocalTGRank() == 0)
  {
    wset.setProperty(OVLP, ovlp);
    wset.setProperty(E1_, eloc(eloc.extension(), 0));
    wset.setProperty(EXX_, eloc(eloc.extension(), 1));
    wset.setProperty(EJ_, eloc(eloc.extension(), 2));
  }
  TG_.TG_local().barrier();
}

/*
 * Stochastic mixed density matrix for the force bias (Phase 3a, static-ensemble limit). For each
 * outer walker phi_w we reduce the inner ensemble {psi_p} (p = 0..P-1) into the effective mixed
 * density matrix the force bias contracts against,
 *   G[w] = sum_p <psi_p|c^dag c|phi_w> / sum_p <psi_p|phi_w>,
 * estimator 3 of arXiv:2505.18519 in the inner_nsteps = 0 limit (B_T = 1, so the phase factor S(Y)
 * and importance reweighting of Eq. 25-26 are degenerate and reduce to a plain average; those arrive
 * with inner propagation in Phase 3b/3c). The contraction x_gamma[w] = L_gamma . G[w] (estimator 4)
 * then runs through the unchanged StochasticWfn::vbias delegate.
 *
 * This mirrors NOMSD::MixedDensityMatrix_shared's CI-weighted accumulate-then-normalize, with the
 * trial-determinant loop replaced by the inner-walker loop and the CI weight conj(ci[nd]) replaced by
 * 1/P: per inner walker we form the normalized cross mixed DM and its overlap against every outer
 * walker via DensityMatrix(..., herm = false) (reusing the Phase 2b machinery), accumulate the
 * overlap-weighted numerator (1/P)<psi_p|phi_w> G_{p,w} and the denominator (1/P)<psi_p|phi_w>, then
 * divide. The 1/P cancels, so G[w]'s overlap normalization is the same reduction as the Phase 2a/2b Ov.
 * herm = false because the inner-walker Slater matrix is [NMO, NEL] (the Phase 2a/2b convention), not
 * the pre-transposed trial NOMSD passes with herm = true; both produce the same G.
 *
 * The output layout (compact / transposed) is the vbias layout of the OUTER delegate nomsd_, read from
 * nomsd_.compact_G_for_vbias / nomsd_.transposed_G_for_vbias_ (friend access), so the reduced G is
 * exactly what nomsd_.vbias expects. Hamiltonian sourcing (dual-Hamiltonian architecture; see
 * StochasticDevelopment.md): the cross DM is Hamiltonian-independent but is run on the OUTER nomsd_
 * (True Ham) so Overlap (2a) / Energy (2b) / vbias (3a) share one SDetOp; the inner stack's HamOps
 * becomes the Variational Ham at Phase 3b, when inner_nomsd() would be the wrong operator. The nd = 0
 * static-anchor assumption is implicit: at inner_nsteps = 0 every inner walker equals the trial anchor
 * (getInitialGuess == OrbMats[0]), so the compact DM's bra basis matches nomsd_'s half-rotated Cholesky
 * (vbias has no per-determinant nd). Phase 3b must revisit this once inner walkers leave the anchor.
 *
 * The weighted numerator is accumulated in a full-precision shared scratch (Gnum) and cast once into
 * the caller's (possibly single-precision) vbias G via copy_n_cast, so the reduction never mixes
 * precisions in ma::add / ma::elementwise; this mirrors the propagator's own SP handling.
 *
 * The inner-walker loop below (guards, herm = false cross DM on nomsd_, Ov += (1/P)⟨ψ_p|φ_w⟩) is
 * intentionally parallel to Energy (Phase 2b). It is deliberately NOT yet factored into a shared
 * helper: Phase 3b changes the per-pair weight (1/P → the S_p phase factor) in both methods at once,
 * so the shared reduction is extracted then, when its final shape (S_p, propagated ψ_p, per-walker nd)
 * is fixed and can be rebuilt/tested. See the Phase 3b "Refactor (do here)" row in StochasticDevelopment.md.
 */
template<bool MP, class devPsiT>
template<class WlkSet, class MatG>
void StochasticWfn<MP, devPsiT>::MixedDensityMatrix_for_vbias(const WlkSet& wset, MatG&& G)
{
  using std::fill_n;
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::MixedDensityMatrix_for_vbias: inner walkers not initialized "
              "(call maybe_initialize_stochastic_inner_walkers first).");
  // Distributed Cholesky (NGroupsPerTG > 1) is deferred, as in Phase 2b Energy: the distributed
  // propagators pass cross-group G buffers this shared-limit reduction does not handle.
  if (TG_.getNGroupsPerTG() > 1)
    APP_ABORT("Error in StochasticWfn::MixedDensityMatrix_for_vbias: distributed (NGroupsPerTG > 1) "
              "stochastic force bias not yet supported (Phase 3a is shared-only; see StochasticDevelopment.md).");

  WalkerSet& inner = *inner_ensemble_.wset;
  const int nwalk  = wset.size();
  const int P      = inner.size();
  RUNTIME_CHECK(P >= 1, "");

  // Layout/scoring against the True Hamiltonian: use the OUTER delegate nomsd_, not inner_nomsd()
  // (whose HamOps becomes the Variational Ham at Phase 3b). The cross DM is Ham-independent, but the
  // vbias layout flags and the downstream vbias contraction are the outer delegate's.
  NOMSD<MP, devPsiT>& ref = nomsd_;
  const bool compact    = ref.compact_G_for_vbias;
  const bool transposed = ref.transposed_G_for_vbias_;
  const int Gsize       = ref.dm_size(not compact); // == size_of_G_for_vbias()
  const bool collinear  = (ref.getWalkerType() == COLLINEAR);
  const ComplexType zero(0.0);
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);

  // Output G must be in the vbias layout NOMSD::vbias expects (same checks as DensityMatrix_shared).
  RUNTIME_CHECK(G.stride(1) == 1, "");
  if (transposed)
    RUNTIME_CHECK(G.size(0) == nwalk && G.size(1) == Gsize, "");
  else
    RUNTIME_CHECK(G.size(1) == nwalk && G.size(0) == Gsize, "");
  RUNTIME_CHECK(G.stride(0) == G.size(1), ""); // contiguous: cast-copy spans Gsize*nwalk linearly

  int nr = Gsize, nc = nwalk;
  if (transposed)
    std::swap(nr, nc);

  // Shared scratch: full-precision numerator Gnum (same layout as G), the per-inner-walker normalized
  // cross mixed DM Gp (same layout), and Gp's per-walker overlap ov_, packed contiguously (mirrors
  // NOMSD::Energy_shared / the Phase 2b shmbuff). Gp/ov_ must be shared because DensityMatrix fills
  // them collectively (round-robin over walkers across the local TG).
  StaticSHMVector shmbuff(iextensions<1u>{(2 * Gsize + 1) * nwalk}, zero,
                          shm_buffer_manager.get_generator().template get_allocator<ComplexType>());
  CMatrix_ref Gnum(make_device_ptr(shmbuff.origin()), {nr, nc});
  CMatrix_ref Gp(Gnum.origin() + Gnum.num_elements(), {nr, nc});
  CVector_ref ov_(Gp.origin() + Gp.num_elements(), iextensions<1u>{nwalk});
  // Total overlap denominator Ov[w] = sum_p (1/P)<psi_p|phi_w>; per-core local but complete on every
  // core (accumulated from the shared, complete ov_), as in Energy.
  StaticVector Ov(iextensions<1u>{nwalk}, buffer_manager.get_generator().template get_allocator<ComplexType>());

  fill_n(Ov.origin(), nwalk, zero);
  fill_n(Gnum.origin(), Gnum.num_elements(), zero);
  TG_.TG_local().barrier();

  // Partition the Gsize dimension of the shared numerator across the local TG (all walkers stay in
  // each band), exactly as NOMSD::MixedDensityMatrix_shared partitions its normalization, so each band
  // of Gnum is written by a single core -- no mutex, no double counting.
  int r0, rN;
  std::tie(r0, rN) = FairDivideBoundary(TG_.getLocalTGRank(), Gsize, TG_.getNCoresPerTG());

  for (int ip = 0; ip < P; ++ip)
  {
    auto smA = inner[ip].SlaterMatrix(Alpha);
    auto smB = (collinear ? inner[ip].SlaterMatrix(Beta) : inner[ip].SlaterMatrix(Alpha));
    // Gp = <psi_p|c^dag c|phi_w>/<psi_p|phi_w> (normalized), ov_ = <psi_p|phi_w> (full overlap;
    // squared for CLOSED, alpha*beta for COLLINEAR, as in NOMSD). Fills the whole shared Gp/ov_.
    ref.DensityMatrix(wset, *smA, *smB, Gp, ov_, /*herm=*/false, compact, transposed);
    // Ov[w] += (1/P)<psi_p|phi_w>   -- the Phase 2a/2b overlap reduction term (complete on every core).
    ma::axpy(inv_P, ov_, Ov);
    // Numerator: Gnum[w] += (1/P)<psi_p|phi_w> Gp[w], on this core's Gsize-band only. Weight Gp in
    // place by inv_P*ov_ along the walker axis, then add into Gnum (both full precision: no mixed add).
    if (rN > r0)
    {
      if (transposed)
      {
        auto Gpband   = Gp(Gp.extension(0), {r0, rN});
        auto Gnumband = Gnum(Gnum.extension(0), {r0, rN});
        ma::elementwise(ma::TOp_MUL, 0, inv_P, ov_, Gpband);
        ma::add(ComplexType(1.0), Gpband, ComplexType(1.0), Gnumband, Gnumband);
      }
      else
      {
        auto Gpband   = Gp.sliced(r0, rN);
        auto Gnumband = Gnum.sliced(r0, rN);
        ma::elementwise(ma::TOp_MUL, 1, inv_P, ov_, Gpband);
        ma::add(ComplexType(1.0), Gpband, ComplexType(1.0), Gnumband, Gnumband);
      }
    }
  }

  // Normalize the numerator by the total overlap: G[w] = Gnum[w] / Ov[w] (this core's band only).
  if (rN > r0)
  {
    if (transposed)
    {
      auto Gnumband = Gnum(Gnum.extension(0), {r0, rN});
      ma::elementwise(ma::TOp_DIV, 0, Ov, Gnumband);
    }
    else
    {
      auto Gnumband = Gnum.sliced(r0, rN);
      ma::elementwise(ma::TOp_DIV, 1, Ov, Gnumband);
    }
  }
  TG_.TG_local().barrier();

  // Cast the full-precision numerator into the caller's (possibly single-precision) vbias G. Partition
  // the linear copy across the local TG; Gnum and G share an identical contiguous layout.
  int e0, eN;
  std::tie(e0, eN) = FairDivideBoundary(TG_.getLocalTGRank(), int(Gnum.num_elements()), TG_.getNCoresPerTG());
  if (eN > e0)
    copy_n_cast(make_device_ptr(Gnum.origin()) + e0, eN - e0, make_device_ptr(G.origin()) + e0);
  TG_.TG_local().barrier();
}

template<bool MP, class devPsiT>
template<class Mat>
void StochasticWfn<MP, devPsiT>::G_MF(Mat&& G)
{
  nomsd_.G_MF(std::forward<Mat>(G));
}

template<bool MP, class devPsiT>
template<class Vec>
void StochasticWfn<MP, devPsiT>::vMF(Vec&& v, double dt)
{
  nomsd_.vMF(std::forward<Vec>(v), dt);
}

